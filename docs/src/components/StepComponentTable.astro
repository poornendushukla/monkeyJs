---
// StepComponentTable.astro
---
<div class="mt-4 overflow-x-auto">
  <table class="min-w-full text-sm text-left border border-gray-300 rounded-lg shadow-sm bg-white">
    <thead class="bg-gradient-to-r from-purple-100 to-blue-100">
      <tr>
        <th class="px-4 py-3 border-b border-gray-200 font-semibold text-gray-800">Property</th>
        <th class="px-4 py-3 border-b border-gray-200 font-semibold text-gray-800">Type</th>
        <th class="px-4 py-3 border-b border-gray-200 font-semibold text-gray-800">Required</th>
        <th class="px-4 py-3 border-b border-gray-200 font-semibold text-gray-800">Description</th>
      </tr>
    </thead>
    <tbody>
      <tr class="hover:bg-purple-50">
        <td class="px-4 py-3 border-b border-gray-100 font-bold">element</td>
        <td class="px-4 py-3 border-b border-gray-100">string</td>
        <td class="px-4 py-3 border-b border-gray-100">Yes</td>
        <td class="px-4 py-3 border-b border-gray-100">ID of the HTML element to highlight (without the <code>#</code> prefix).</td>
      </tr>
      <tr class="hover:bg-purple-50">
        <td class="px-4 py-3 border-b border-gray-100 font-bold">title</td>
        <td class="px-4 py-3 border-b border-gray-100">string</td>
        <td class="px-4 py-3 border-b border-gray-100">Yes</td>
        <td class="px-4 py-3 border-b border-gray-100">Title displayed in the popover.</td>
      </tr>
      <tr class="hover:bg-purple-50">
        <td class="px-4 py-3 border-b border-gray-100 font-bold">description</td>
        <td class="px-4 py-3 border-b border-gray-100">string</td>
        <td class="px-4 py-3 border-b border-gray-100">Yes</td>
        <td class="px-4 py-3 border-b border-gray-100">Main content or description shown in the popover body.</td>
      </tr>
      <tr class="hover:bg-purple-50">
        <td class="px-4 py-3 border-b border-gray-100 font-bold">action</td>
        <td class="px-4 py-3 border-b border-gray-100">() =&gt; Promise&lt;unknown&gt;</td>
        <td class="px-4 py-3 border-b border-gray-100">No</td>
        <td class="px-4 py-3 border-b border-gray-100">Optional async action executed when this step is shown.</td>
      </tr>
      <tr class="hover:bg-purple-50">
        <td class="px-4 py-3 border-b border-gray-100 font-bold">condition</td>
        <td class="px-4 py-3 border-b border-gray-100">() =&gt; boolean</td>
        <td class="px-4 py-3 border-b border-gray-100">No</td>
        <td class="px-4 py-3 border-b border-gray-100">Optional condition function. The step is skipped if this returns <code>false</code>.</td>
      </tr>
    </tbody>
  </table>
</div>
