---
layout: '../../layouts/DocuLayout.astro'
title: 'Configuration'
import DocuLayout from '~/layouts/DocuLayout.astro';
import CodeBlock from '../../components/astro-components/common/CodeBlock.astro';

const tourConfig = `
{
  controllerConfig: TourControllerConfig,  // Configuration for the tour controller
  tourConfig: PopoverBuilderConfig         // Configuration for the popovers
}`

const controllerConfig = `
{
  steps: stepComponent[]  // Array of step configurations
}`

const stepComponent = `
{
  element: string,                    // ID of the HTML element to highlight (without '#')
  title: string,                      // Title of the step
  description: string,                // Content/description for the step
  action?: () => Promise<unknown>,    // Optional: Async action executed when step is shown
  condition?: () => boolean           // Optional: Skip this step if the function returns false
}`
const popoverBuilderConfig = `
{
  overlayConfig: OverlayBuilderConfig; // Configuration for the overlay
  progressBar: boolean;                // Show progress bar
  progressBarSteps: number;            // Number of steps in the progress bar
  nextBtnText: string;                 // Text for the next button
  prevBtnText: string;                 // Text for the previous button
  position: TPopoverPosition;          // Position of the popover
  offsetX: number;                     // Horizontal offset for the popover
  offsetY: number;                     // Vertical offset for the popover
  isArrowVisible: boolean;             // Show arrow on the popover
  isCloseBtnVisible: boolean;          // Show close button on the popover
}`

const themeType = `
{
  fontFamily: string;
  fontSize: string;
  textColor: string;
  popoverBgColor: string;
  popoverPadding: string;
  popoverBorderRadius: string;
  popoverBoxShadow: string;
  popoverBtnPadding: string;
  overlayColor: string;
  overlayOpacity: number;
  overlayRadius: string;
  overlayPadding: string;
  overlayStrokeWidth: number;
  ovelayStrokeColor: string;
  primaryBtnBgColor: string;
  primaryBtnColor: string;
  secondaryBtnColor: string;
  secondaryBtnBgColor: string;
  baseZIndex: number;
  overlayZIndex: number;
  arrowColor: string;
}`
const example = `
import { Tour, POPOVER_POSITION_CONSTANT } from 'monkeyts';

const tour = new Tour({
  controllerConfig: {
    steps: [
      {
        element: 'step-1',
        title: 'Welcome',
        description: 'This is the first step of your tour!',
        action: async () => console.log('Step 1 shown')
      },
      {
        element: 'step-2',
        title: 'Features',
        description: 'Here you can find all the features.',
        condition: () => document.getElementById('step-2') !== null
      }
    ]
  },
  tourConfig: {
    isArrowVisible: true,
    isCloseBtnVisible: true,
    position: POPOVER_POSITION_CONSTANT.BOTTOM,
    progressBar: true,
    progressBarSteps: 2,
    nextBtnText: '',
    prevBtnText: '',
    offsetX: 0,
    offsetY: 0,
    overlayConfig: {
      radius: 10,
      padding: { top: 10, bottom: 10, right: 10, left: 10 }
    }
  }
}, {
  primaryBtnBgColor: '#3b82f6',
  secondaryBtnBgColor: '#6366f1',
  textColor: '#1f2937',
  fontFamily: 'system-ui, -apple-system, sans-serif'
});`
---

<DocuLayout>
<div class="docs-content">
  <h1 class="text-3xl font-bold text-gray-900">Configuration</h1>
  <p class="mt-4 text-lg text-gray-700">
    Learn about all the configuration options available in MonkeyTs.
  </p>

  <div class="mt-8 space-y-10">
    <section>
      <h2 class="text-2xl font-semibold text-gray-800">Tour Configuration</h2>
      <p class="mt-2 text-gray-700">
        The main configuration object used when creating a new tour. It includes the <span><a href="#controller-configuration" class="text-purple-600 hover:underline">controller configuration</a></span> and <span><a href="#popover-configuration" class="text-purple-600 hover:underline">popover builder configuration</a></span>.
      </p>
      
      <div class="mt-6 border border-gray-200 rounded-md overflow-hidden">
        <div class="bg-gray-50 px-4 py-2 border-b border-gray-200">
          <h3 class="font-semibold  text-gray-800">Tour Configuration</h3>
        </div>
        <div class="p-4">
          <CodeBlock code={tourConfig} language="js" />
        </div>
      </div>
    </section>

    <section id="controller-configuration">
      <h2 class="text-2xl font-semibold text-gray-800">Controller Configuration</h2>
      <p class="mt-2 text-gray-700">
        Configuration options for the tour controller.
      </p>
      
      <div class="mt-6 border border-gray-200 rounded-md overflow-hidden">
        <div class="bg-gray-50 px-4 py-2 border-b border-gray-200">
          <h3 class="font-medium text-gray-800">TourControllerConfig</h3>
        </div>
        <div class="p-4">
          <CodeBlock code={controllerConfig} language="javascript" filename='controller config'/>
        </div>
      </div>
      
      <div class="mt-6 border border-gray-200 rounded-md overflow-hidden">
        <div class="bg-gray-50 px-4 py-2 border-b border-gray-200">
          <h3 class="font-medium text-gray-800">stepComponent</h3>
        </div>
        <div class="p-4">
          <CodeBlock code={stepComponent} language="javascript" />
        </div>
      </div>
    </section>

    <section id="popover-configuration">
      <h2 class="text-2xl font-semibold text-gray-800">Popover Configuration</h2>
      <p class="mt-2 text-gray-700">
        Configuration options for the tour popovers.
      </p>
      
      <div class="mt-6 border border-gray-200 rounded-md overflow-hidden">
        <div class="bg-gray-50 px-4 py-2 border-b border-gray-200">
          <h3 class="font-medium text-gray-800">PopoverBuilderConfig</h3>
        </div>
        <div class="p-4">
          <CodeBlock code={popoverBuilderConfig} language="javascript" />
        </div>
      </div>
    </section>

    <section id="theme-configuration">
      <h2 class="text-2xl font-semibold text-gray-800">Theme Configuration</h2>
      <p class="mt-2 text-gray-700">
        Customize the appearance of the tour components.
      </p>
      
      <div class="mt-6 border border-gray-200 rounded-md overflow-hidden">
        <div class="bg-gray-50 px-4 py-2 border-b border-gray-200">
          <h3 class="font-medium text-gray-800">ThemeType</h3>
        </div>
        <div class="p-4">
          <CodeBlock code={themeType} language="javascript" />
        </div>
      </div>
    </section>
    
    <section class="pb-8">
      <h2 class="text-2xl font-semibold text-gray-800">Example Configuration</h2>
      <p class="mt-2 text-gray-700">
        Here's a complete example of configuring a tour:
      </p>

      <div class="mt-6 border border-gray-200 rounded-md overflow-hidden">
        <div class="bg-gray-50 px-4 py-2 border-b border-gray-200">
          <h3 class="font-medium text-gray-800">tourConfig.js</h3>
        </div>
        <div class="p-4">
          <CodeBlock code={example} language="javascript" />
        </div>
      </div>
    </section>
  </div>
</div>
</DocuLayout>
