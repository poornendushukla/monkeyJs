---
layout: '../../layouts/DocuLayout.astro'
title: 'Examples'
import DocuLayout from '~/layouts/DocuLayout.astro';
import CodeBlock from '../../components/astro-components/common/CodeBlock.astro';

const exampleConfig = `
// HTML Structure
// <div id="welcome-screen">Welcome to our app!</div>
// <button id="features-button">Features</button>
// <div id="settings-panel">Settings</div>

import { Tour, POPOVER_POSITION_CONSTANT } from 'monkeyts';

// Define your tour steps
const steps = [
  {
    element: 'welcome-screen',
    title: 'Welcome',
    description: 'Welcome to our application! This tour will guide you through the main features.'
  },
  {
    element: 'features-button',
    title: 'Features',
    description: 'Click here to explore all the features available in our app.'
  },
  {
    element: 'settings-panel',
    title: 'Settings',
    description: 'Access your account settings and preferences here.'
  }
];

// Initialize tour
const tour = new Tour({
  controllerConfig: { steps },
  tourConfig: {
    isArrowVisible: true,
    isCloseBtnVisible: true,
    position: POPOVER_POSITION_CONSTANT.BOTTOM,
    progressBar: false,
    progressBarSteps: 0,
    nextBtnText: '',
    prevBtnText: '',
    offsetX: 0,
    offsetY: 0,
    overlayConfig: {
      radius: 10,
      padding: { top: 10, bottom: 10, right: 10, left: 10 }
    }
  }
});

// Start the tour
tour.initTour();
tour.start();`

const customThemeConfig = `
import { Tour, POPOVER_POSITION_CONSTANT } from 'monkeyts';

// Define your tour steps
const steps = [
  {
    element: 'step-1',
    title: 'Custom Theme',
    description: 'This tour uses a custom theme with different colors and styling.'
  },
  {
    element: 'step-2',
    title: 'Branding',
    description: 'You can match the tour to your brand colors and design system.'
  }
];

// Define custom theme
const customTheme = {
  primaryBtnBgColor: '#10b981',
  secondaryBtnBgColor: '#3b82f6',
  textColor: '#1f2937',
  fontFamily: 'Poppins, sans-serif'
};

// Tour configuration
const tourConfig = {
  isArrowVisible: true,
  isCloseBtnVisible: true,
  position: POPOVER_POSITION_CONSTANT.BOTTOM,
  progressBar: false,
  progressBarSteps: 0,
  nextBtnText: '',
  prevBtnText: '',
  offsetX: 0,
  offsetY: 0,
  overlayConfig: {
    radius: 10,
    padding: { top: 10, bottom: 10, right: 10, left: 10 }
  }
};

// Initialize tour with custom theme
const tour = new Tour({
  controllerConfig: { steps },
  tourConfig
}, customTheme);

// Start the tour
tour.initTour();
tour.start();
`

const reactIntegrationExample = `
import React from 'react';
import { TourContext, useTourContext } from 'react-monkeyjs';
import { POPOVER_POSITION_CONSTANT } from 'monkeyts';

// Define your tour steps
const steps = [
  {
    element: 'dashboard',
    title: 'Dashboard',
    description: 'This is your dashboard where you can see an overview of your activity.'
  },
  {
    element: 'profile-button',
    title: 'Profile',
    description: 'Click here to view and edit your profile information.'
  },
  {
    element: 'notifications',
    title: 'Notifications',
    description: 'Your notifications will appear here.'
  }
];

// Main App component
function App() {
  return (
    <TourContext
      steps={steps}
      config={{
        isArrowVisible: true,
        isCloseBtnVisible: true,
        position: POPOVER_POSITION_CONSTANT.BOTTOM,
        progressBar: true,
        progressBarSteps: steps.length,
        nextBtnText: '',
        prevBtnText: '',
        offsetX: 0,
        offsetY: 0,
        overlayConfig: {
          radius: 10,
          padding: { top: 10, bottom: 10, right: 10, left: 10 }
        }
      }}
    >
      <YourComponent />
    </TourContext>
  );
}

// Start the tour from a child component
function StartButton() {
  const { start } = useTourContext();

  return (
    <button onClick={start}>
      Start Tour
    </button>
  );
}`

const advancedEventHandling = `import { Tour, POPOVER_POSITION_CONSTANT } from 'monkeyts';

// Define your tour steps with actions
const steps = [
  {
    element: 'login-form',
    title: 'Login',
    description: 'Enter your credentials here to log in.',
    action: async () => {
      console.log('Login step shown');
      window.analytics?.track('tour_step_login_viewed');
    }
  },
  {
    element: 'search-bar',
    title: 'Search',
    description: 'Use the search bar to find what you need quickly.',
    action: async () => {
      console.log('Search step shown');
      document.querySelector('#search-bar')?.focus();
    }
  },
  {
    element: 'help-button',
    title: 'Help',
    description: 'Click here if you need assistance at any time.'
  }
];

// Listen for tour lifecycle events
window.addEventListener('onEnd', () => {
  console.log('Tour completed');
  localStorage.setItem('hasCompletedTour', 'true');
});

// Initialize tour
const tour = new Tour({
  controllerConfig: { steps },
  tourConfig: {
    isArrowVisible: true,
    isCloseBtnVisible: true,
    position: POPOVER_POSITION_CONSTANT.BOTTOM,
    progressBar: false,
    progressBarSteps: 0,
    nextBtnText: '',
    prevBtnText: '',
    offsetX: 0,
    offsetY: 0,
    overlayConfig: {
      radius: 10,
      padding: { top: 10, bottom: 10, right: 10, left: 10 }
    }
  }
});

// Start the tour
tour.initTour();

// Check if user has completed the tour before
const hasCompletedTour = localStorage.getItem('hasCompletedTour') === 'true';
if (!hasCompletedTour) {
  tour.start();
}`
---

<DocuLayout>
<div class="docs-content">
  <h1 class="text-3xl font-bold text-gray-900">Examples</h1>
  <p class="mt-4 text-lg text-gray-700">
    Explore practical examples of using MonkeyJs in different scenarios.
  </p>

  <div class="mt-8 space-y-10">
    <section>
      <h2 class="text-2xl font-semibold text-gray-800" id="basic-tour-example">Basic Tour Example</h2>
      <p class="mt-2 text-gray-700">
        A simple example of creating a basic tour with MonkeyJs.
      </p>
      
      <CodeBlock code={exampleConfig} language="js" filename="basic-tour.ts" />
    </section>

    <section>
      <h2 class="text-2xl font-semibold text-gray-800" id="custom-themed-tour">Custom Themed Tour</h2>
      <p class="mt-2 text-gray-700">
        An example of a tour with custom theming.
      </p>
      
      <CodeBlock code={customThemeConfig} language="js" filename="themed-tour.ts" />
    </section>

    <section>
      <h2 class="text-2xl font-semibold text-gray-800" id="react-integration-example">React Integration Example</h2>
      <p class="mt-2 text-gray-700">
        An example of using MonkeyJs with React.
      </p>
      
      <CodeBlock code={reactIntegrationExample} language="js" filename="ReactTour.tsx" />
    </section>

    <section>
      <h2 class="text-2xl font-semibold text-gray-800" id="advanced-event-handling">Advanced Event Handling</h2>
      <p class="mt-2 text-gray-700">
        An example showing how to use event callbacks with tour steps.
      </p>
      
      <CodeBlock code={advancedEventHandling} language="js" filename="event-handling.ts" />
    </section>
    
    <section class="pb-8">
      <h2 class="text-2xl font-semibold text-gray-800">Next Steps</h2>
      <p class="mt-2 text-gray-700">
        Now that you've seen these examples, you might want to explore:
      </p>
      <ul class="mt-2 ml-6 list-disc text-gray-700 space-y-2">
        <li><a href="/monkeyJs/docs/api" class="text-purple-600 hover:underline">Complete API Reference</a></li>
        <li><a href="/monkeyJs/docs/configuration" class="text-purple-600 hover:underline">Configuration Options</a></li>
      </ul>
    </section>
  </div>
</div>
</DocuLayout>
